# Clerk — authentication for the site header, /sign-in, /sign-up and /studio.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/studio
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/studio

# Sentry — error tracking and source-map upload during `next build`.
SENTRY_AUTH_TOKEN=

# ImageKit — media CDN used by the marketing sections.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATEKEY_VALUE=

# Database — not wired up yet.
DATABASE_URL=

# Studio render engine — leave both unset to keep rendering switched off.
# /studio then shows the "engine not connected" notice and POST /api/generate
# answers 501. See lib/studio-engine.ts for the request contract the endpoint
# is expected to implement.
RENDER_ENGINE_URL=
RENDER_ENGINE_API_KEY=
