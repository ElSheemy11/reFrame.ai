# Clerk — authentication for the site header, /sign-in, /sign-up and /studio.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/studio
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/studio

# Sentry — error tracking and source-map upload during `next build`.
SENTRY_AUTH_TOKEN=

# ImageKit — media CDN used by the marketing sections.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATEKEY_VALUE=

# Database — not wired up yet.
DATABASE_URL=

# Google Gemini — the studio's image engine (via the Vercel AI SDK).
# Server-only: never add the NEXT_PUBLIC_ prefix. Leave it unset to keep
# rendering switched off — /studio shows the "engine not connected" notice and
# POST /api/generate answers 503. See lib/gemini.ts.
GOOGLE_GENERATIVE_AI_API_KEY=
